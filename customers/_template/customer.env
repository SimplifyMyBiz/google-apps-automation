# Per-customer settings.
# Copy this folder to customers/<slug>/ and fill in. customers/<slug>/ is gitignored.

CUSTOMER_SLUG=""                  # short lowercase id, e.g. acme-plumbing (used in bucket and job names)
CUSTOMER_NAME=""                  # display name, e.g. "Acme Plumbing LLC"
CUSTOMER_DOMAIN=""                # primary Workspace domain, e.g. acmeplumbing.com

# SimplifyMyBiz (SMB) accounts inside this customer's tenant
CUSTOMER_SUPERADMIN=""            # daily super-admin, e.g. smb-admin@acmeplumbing.com
CUSTOMER_EMERGENCY_ADMIN=""       # emergency super-admin, never used day to day, e.g. smb-defcon@acmeplumbing.com

# Workspace
WORKSPACE_EDITION="business_starter"  # business_starter | business_standard | business_plus
INTAKE_SHEET_ID=""                # Google Sheet listing employees (later phase)

# DNS (Cloudflare). Leave zone ID blank to look it up by domain.
CLOUDFLARE_ZONE_ID=""
DMARC_POLICY="none"               # start at none, move to quarantine/reject once reports look clean
DMARC_RUA=""                      # report address from Cloudflare DMARC Management for this zone (blank until enabled)
