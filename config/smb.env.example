# SimplifyMyBiz (SMB) settings, shared by all customers.
# Copy to config/smb.env and fill in. config/smb.env is gitignored.
#
# GCP resources (project, service accounts, buckets) are built by separate Terraform.
# Values this repo needs from it get added here as plain variables in the GAM phase.

# --- Cloudflare ---
# API token with Zone:DNS:Edit (and Zone:Read) on customer zones.
# Prefer exporting it in your shell over writing it here.
CLOUDFLARE_API_TOKEN="${CLOUDFLARE_API_TOKEN:-}"
